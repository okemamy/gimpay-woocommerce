msgstr "Options avancées"

#: includes/class-gimpay-gateway.php:148
msgid "Amount unit"
msgstr "Unité du montant"

#: includes/class-gimpay-gateway.php:150
msgid "GIM Pay expects the amount in the smallest currency unit. XOF has no minor unit: keep \"× 1\" unless GIM Pay tells you otherwise."
msgstr "GIM Pay attend le montant dans la plus petite unité. Le XOF n’a pas de centimes : laissez « × 1 » sauf indication contraire de GIM Pay."

#: includes/class-gimpay-gateway.php:153
msgid "× 1 (1,000 XOF sent as 1000)"
msgstr "× 1 (1 000 XOF envoyé comme 1000)"

#: includes/class-gimpay-gateway.php:154
msgid "× 100 (1,000 XOF sent as 100000)"
msgstr "× 100 (1 000 XOF envoyé comme 100000)"

